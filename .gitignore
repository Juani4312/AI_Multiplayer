# Binarios del juego: nunca se commitean
game/
*.exe
*.dll
# excepción: las DLL del mod (compiladas por nosotros) para instalar sin toolchain
!mod/dist/*.dll
*.pak
*.PAK

# Evidencia de REA/Ghidra (puede contener pseudocódigo/strings del juego)
work/evidence/*
!work/evidence/.gitkeep

# Proyectos/DB de Ghidra
*.gpr
*.rep/
*.lock
*.lock~

# Build del mod
build/
mod/build/
*.o
*.obj
*.a
*.lib
*.so
*.asi
*.pdb
*.exp

# Varios
.DS_Store
*.swp

# Backups locales de saves (saves.sh load)
saves/backups/
# Modo de papito (work/scripts/mode.sh)
saves/.mode
work/scripts/__pycache__/
instalacion-informe.md

# Herramientas (work/tools): salida de compilación de .NET
work/tools/cathode-dump/bin/
work/tools/cathode-dump/obj/

# Temporales del proyecto (capturas de las pruebas en tmp/screenshots/, archivos de trabajo): locales
/tmp/

# Locales de papito (pedido del usuario, 2026-11-21): no van al repo público
# - partidas guardadas (de prueba y las del usuario)
/saves/
# - scripts personales: partidas y mods de terceros del usuario, ventana del juego en su Hyprland, pruebas con sus rutas
work/scripts/mode.sh
work/scripts/saves.sh
work/scripts/check_install.sh
work/scripts/game_window.sh
work/scripts/autoplay_continue.sh
# - instrucciones para Claude Code de la máquina de desarrollo (quedan INSTALAR_CON_CLAUDE.md y work/windows/, que usan
