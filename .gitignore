# Binarios del juego: nunca se commitean
game/
*.exe
*.dll
# excepción: las DLL del mod (compiladas por nosotros) para instalar sin toolchain
!mod/dist/*.dll
*.pak
*.PAK

# Evidencia de REA/Ghidra (puede contener pseudocódigo/strings del juego)
work/evidence/*
!work/evidence/.gitkeep

# Proyectos/DB de Ghidra
*.gpr
*.rep/
*.lock
*.lock~

# Build del mod
build/
mod/build/
*.o
*.obj
*.a
*.lib
*.so
*.asi
*.pdb
*.exp

# Varios
.DS_Store
*.swp

# Backups locales de saves (saves.sh load)
saves/backups/
# Modo de papito (work/scripts/mode.sh)
saves/.mode
work/scripts/__pycache__/
instalacion-informe.md

# Herramientas (work/tools): salida de compilación de .NET
work/tools/cathode-dump/bin/
work/tools/cathode-dump/obj/
